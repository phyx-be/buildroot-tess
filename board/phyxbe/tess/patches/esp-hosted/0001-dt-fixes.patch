+					__func__, ntfy_payload->bssid.len);
+
+			ntfy_payload->bssid.len = 0;
+			ntfy_payload->resp = ESP_ERR_NO_MEM;
+			goto err;
+		}
+	}
+
+	ntfy_payload->resp = SUCCESS;
+	return ESP_OK;
+
+err:
+	ESP_LOGE(TAG, "%s: event incomplete", __func__);
+
+	return ESP_OK;
