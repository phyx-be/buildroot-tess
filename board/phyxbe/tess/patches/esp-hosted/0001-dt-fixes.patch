+	ntfy_payload->authmode = evt->authmode;
+	ntfy_payload->aid = evt->aid;
+	ntfy_payload->channel = evt->channel;
+	ntfy_payload->resp = FAILURE;
+
+	/* ssid */
+	ntfy_payload->ssid_len = evt->ssid_len;
